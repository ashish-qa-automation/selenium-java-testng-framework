<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo-Regression" verbose="1" parallel="methods" thread-count="2">
    <listeners>
        <listener class-name="com.automation.listeners.TestListener"/>
        <listener class-name="com.automation.listeners.RetryTransformer"/>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <test name="RegressionTests">
        <groups>
            <run>
                <include name="smoke"/>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.automation.tests.FrameworkSmokeTest"/>
            <class name="com.automation.tests.LoginTests"/>
            <class name="com.automation.tests.CartTests"/>
            <class name="com.automation.tests.CheckoutTests"/>
        </classes>
    </test>
</suite>
